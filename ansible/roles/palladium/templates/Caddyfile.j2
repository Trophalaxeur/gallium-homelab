# Managed by Ansible (palladium role) — do not edit on the host.
#
# The only host the Livebox forwards to (443). One cert covers the three names
# (palladium-cert role, issued on adguard and pushed over SSH).
#
# - {{ homeassistant_domain }} and {{ immich_domain }} require a client
#   certificate signed by the client CA AND listed in client-certs.pem: no
#   certificate, or a removed one, and the TLS handshake fails before any HTTP.
#   Revoking a device = deleting its .pem from roles/palladium/files and
#   re-running the play (docs/palladium.md).
# - {{ immich_share_domain }} needs no certificate: immich-public-proxy only
#   serves shared albums, behind the share password.
#
# Upstreams are the LXCs' own Caddy, reached by IP (the LXCs resolve through
# the Livebox, which would send these names back here) with the SNI and Host
# of the real name, so their certificates still verify. `header_up Host {host}`
# is required: for an HTTPS upstream, Caddy's default Host is the upstream
# address (192.168.1.x), which matches no site there — an empty 200 (measured).
# They see palladium as the client and the real address in X-Forwarded-For —
# hassium and immich trust it (their role Caddyfile + HA's trusted proxies).
#
# Never add a `log` directive: requests to {{ homeassistant_domain }} include
# the ha-mcp secret path (its only credential, see the home-assistant role
# Caddyfile), and access logs would write it to disk here too.
(client_cert) {
    tls /etc/caddy/cert/cert.pem /etc/caddy/cert/key.pem {
        client_auth {
            mode require_and_verify
            trust_pool file {{ palladium_mtls_dir }}/client-ca.pem
            verifier leaf {
                file {{ palladium_mtls_dir }}/client-certs.pem
            }
        }
    }
}

{{ homeassistant_domain }} {
    import client_cert
    reverse_proxy https://{{ hassium_ip }} {
        header_up Host {host}
        transport http {
            tls_server_name {{ homeassistant_domain }}
        }
    }
}

{{ immich_domain }} {
    import client_cert
    reverse_proxy https://{{ immich_ip }} {
        header_up Host {host}
        transport http {
            tls_server_name {{ immich_domain }}
        }
    }
}

{{ immich_share_domain }} {
    tls /etc/caddy/cert/cert.pem /etc/caddy/cert/key.pem
    reverse_proxy 127.0.0.1:{{ palladium_ipp_port }}
}
