# Managed by Ansible (backup role). Same scoped Scaleway IAM key as rclone
# (PutObject/GetObject/ListBucket + PutObjectRetention) — read here by boto3 for
# the weekly Object Lock renewal job (list_objects_v2 + put_object_retention,
# which rclone cannot do). Region/endpoint are set on the client by the script.
[default]
aws_access_key_id = {{ vault_rclone_scaleway_access_key }}
aws_secret_access_key = {{ vault_rclone_scaleway_secret_key }}
