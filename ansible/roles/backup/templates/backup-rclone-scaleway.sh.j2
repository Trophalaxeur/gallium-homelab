#!/usr/bin/env bash
# Étape 4a — nightly copy of the Immich photos + DB dumps, and of Home
# Assistant's backups, to Scaleway Object Storage. The bucket has a DEFAULT Object Lock retention (Compliance, 90 days)
# set at creation (scripts/scaleway-bucket-bootstrap.sh), so every freshly PUT
# object is locked automatically — no per-object flag needed here. Weekly
# renewal (backup-object-lock-renew.py) keeps still-present photos locked past
# their original 90 days (Rétention glissante).
#
# rclone COPY (never sync/delete): a deletion in Immich must not propagate to
# the cloud copy — that's a whole point of this tier (Scénario 5/6).
set -uo pipefail

SRC="{{ backup_photos_src }}"
HASSIUM_SRC="{{ backup_hassium_src }}"
REMOTE="{{ rclone_remote }}:{{ scaleway_bucket }}"
LOG="/var/log/backup-rclone-scaleway.log"
KUMA_URL="{{ uptime_kuma_push_base }}/{{ vault_kuma_push_rclone_scaleway }}"
ADMIN="{{ backup_admin_email }}"
FROM="{{ smtp_from_backup | default('backup@flefevre.fr') }}"

exec >>"$LOG" 2>&1
echo "===== $(date -Is) rclone → Scaleway ====="

# Originals only. DB dumps go to their own prefix (below) with a 90-day
# lifecycle expiry. Thumbs and encoded-video are DELIBERATELY excluded: both are
# regenerable from the originals, and Immich rewrites them in place (thumbnail
# regen, re-transcode) reusing the same S3 key. Under the bucket's default
# Object Lock (Compliance, 90d) those overwrites are Forbidden — so each regen
# would pile up locked, undeletable versions AND trigger a 403 storm (46k errors
# on the 2026-07-11 run, after a mobile import re-dated ~31k thumbs). Keep the
# immutable tier to what genuinely cannot be rebuilt.
rclone copy "$SRC" "${REMOTE}/library" \
  --exclude '/backups/**' \
  --exclude '/thumbs/**' \
  --exclude '/encoded-video/**' \
  --transfers 4 --checkers 8 --stats-one-line --stats 1m
rc_lib=$?

# DB dumps — the logical source of truth for a DB restore, MUST ship with the
# photos (limitation #8). Immich writes them to $UPLOAD_LOCATION/backups.
rclone copy "${SRC}/backups" "${REMOTE}/db-backups" \
  --transfers 4 --checkers 8 --stats-one-line --stats 1m
rc_db=$?

# Home Assistant's scheduled backups (HA's own encrypted .tar, written daily
# at 01:30 into the hassium-backups dataset). Own prefix with its own 90-day
# lifecycle expiry, like db-backups/ — never renewed by the Object Lock job.
rclone copy "$HASSIUM_SRC" "${REMOTE}/hassium-backups" \
  --transfers 4 --checkers 8 --stats-one-line --stats 1m
rc_ha=$?

# Deadman gate: only ping success if ALL copies succeeded AND both a DB dump
# and a Home Assistant backup landed in the last 25h (a stale one means
# Immich's Database Backup or HA's scheduled backup silently stopped — a copy
# of stale files is not a restorable backup, cf. limitation #8).
fresh_dump=$(find "${SRC}/backups" -type f -mmin -1500 2>/dev/null | head -1)
fresh_ha=$(find "$HASSIUM_SRC" -type f -name '*.tar' -mmin -1500 2>/dev/null | head -1)

if [[ $rc_lib -eq 0 && $rc_db -eq 0 && $rc_ha -eq 0 && -n "$fresh_dump" && -n "$fresh_ha" ]]; then
  echo "OK — library rc=$rc_lib db rc=$rc_db ha rc=$rc_ha, fresh dump: $fresh_dump, fresh HA backup: $fresh_ha"
  curl -fsS -m 15 --retry 3 -G "$KUMA_URL" \
    --data-urlencode "status=up" --data-urlencode "msg=OK" >/dev/null || true
else
  echo "FAIL — library rc=$rc_lib db rc=$rc_db ha rc=$rc_ha, fresh_dump='${fresh_dump:-none}' fresh_ha='${fresh_ha:-none}'"
  printf 'rclone → Scaleway failed on %s\nlibrary rc=%s db rc=%s ha rc=%s\nfresh DB dump (<25h): %s\nfresh HA backup (<25h): %s\nSee %s\n' \
    "$(hostname)" "$rc_lib" "$rc_db" "$rc_ha" "${fresh_dump:-NONE — Immich DB backup stale}" \
    "${fresh_ha:-NONE — Home Assistant backup stale}" "$LOG" \
    | mail -r "$FROM" -s "[backup] rclone → Scaleway FAILED" "$ADMIN" || true
  # Explicit down push (faster than waiting for the missed-heartbeat timeout);
  # a dead cron that never runs still trips Kuma via the absent push.
  curl -fsS -m 15 -G "$KUMA_URL" \
    --data-urlencode "status=down" --data-urlencode "msg=rclone-scaleway failed" >/dev/null || true
  exit 1
fi
