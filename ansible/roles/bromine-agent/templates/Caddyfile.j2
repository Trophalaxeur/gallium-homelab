# Managed by Ansible (bromine-agent role) — do not edit on the host.
#
# Explicit `tls <cert> <key>` disables Caddy's own ACME for this site: the cert
# is issued on the AdGuard LXC (acme.sh, DNS-01) and pushed here over SSH, so
# Caddy never needs a DNS-provider plugin or outbound ACME. It only terminates
# TLS on :443 and proxies to the backend, which listens on loopback:3000.
{{ bromine_domain }} {
    tls /etc/caddy/cert/cert.pem /etc/caddy/cert/key.pem
    reverse_proxy 127.0.0.1:3000
}
