# Managed by Ansible (home-assistant role) — do not edit on the host.
# Through Caddy, never 127.0.0.1:{{ homeassistant_port }}: see docker-compose.yml.
HOMEASSISTANT_URL=https://{{ homeassistant_domain }}
HOMEASSISTANT_TOKEN={{ vault_ha_mcp_ha_token }}
# The secret path IS the endpoint's only credential (ha-mcp-web has no other
# auth). Caddy routes exactly this prefix to the sidecar.
MCP_SECRET_PATH=/{{ vault_ha_mcp_secret_path }}
MCP_PORT={{ ha_mcp_port }}
# Version is pinned in group_vars; the PyPI checks would only nag. ha-mcp and
# its vendored FastMCP each run their own.
HA_MCP_DISABLE_UPDATE_CHECK=true
FASTMCP_CHECK_FOR_UPDATES=off
FASTMCP_SHOW_SERVER_BANNER=false
# At INFO, two startup lines print the full listen URL, secret path included
# (ha_mcp "Settings UI available at", FastMCP "Starting MCP server"). WARNING
# drops both. It does NOT cover uvicorn's access log, which has its own handler:
# every request line still carries the path (see docs/home-assistant.md).
LOG_LEVEL=WARNING
