# Managed by Ansible (home-assistant role) — do not edit on the host.
#
# OWNERSHIP (decision 2026-10-18): Git owns the automations. The HA UI
# automation editor only ever writes to an UNLABELED `automation:` include —
# there is none here, so the editor cannot overwrite what this repo declares.
# Creating an automation from the UI will therefore fail; that is the point.
# To re-enable UI editing later, add a second include:
#     automation ui: !include automations.yaml
# and create that file. The two keys coexist (labels must differ).
#
# What is deliberately NOT here: the integrations themselves. HA stores them in
# /config/.storage/core.config_entries as internal JSON that must not be
# hand-edited. Adding Overkiz, SolarEdge or a wallbox is a UI step on every
# install type — nothing to template, by design.

default_config:

homeassistant:
  # Behind a reverse proxy HA cannot reliably infer its own address, which
  # breaks the links it generates (companion app, webhooks). Only the internal
  # URL is set: {{ homeassistant_domain }} resolves through the AdGuard rewrite
  # and is never port-forwarded, so there is no external URL to declare.
  internal_url: "https://{{ homeassistant_domain }}"

http:
  # Caddy terminates TLS on :443 on this same LXC and reverse-proxies to
  # 127.0.0.1:{{ homeassistant_port }}. Without these, HA logs every request as
  # coming from the proxy and refuses the forwarded client address.
  use_x_forwarded_for: true
  trusted_proxies:
    - 127.0.0.1
    - ::1
  # Enabled together with use_x_forwarded_for on purpose: the ban list keys on
  # the client address, so turning the first on without the second would count
  # every failed login against the proxy instead of the real caller.
  # Bans are written to /config/ip_bans.yaml — delete the entry to unban.
  ip_ban_enabled: true
  login_attempts_threshold: 5

recorder:
  # Explicit rather than relying on the 10-day default: this LXC has a 16 Go
  # rootfs and the detailed history is what grows. Long-term statistics (the
  # hourly min/max/mean behind the Energy dashboard) live in a separate table
  # that purge never touches — shortening this does NOT cost solar history.
  purge_keep_days: 14
  auto_purge: true

# Git-owned automations, templated from this repo. Labeled include on purpose —
# see the OWNERSHIP note above.
automation ansible: !include automations-managed.yaml
