# Managed by Ansible (home-assistant role) — do not edit on the host.
#
# Same pattern as immich/uptime: the cert is issued on the AdGuard LXC
# (acme.sh, DNS-01 via Online.net) and pushed here over SSH by the
# home-assistant-cert role. Caddy only terminates TLS on :443 and proxies to
# the HA container, which binds {{ homeassistant_port }} on the LXC itself
# (network_mode: host). Caddy forwards HA's websocket transparently — the
# frontend and the MCP/REST API both need it.
#
# Exposure model: HA's "Listen addresses" is set to 127.0.0.1 in the UI
# (docs/home-assistant.md, "Network settings"), so this proxy is the ONLY way
# in — no plaintext {{ homeassistant_port }} on the LAN. Nothing in phase 1
# needs that port from the LAN: Shelly gen1 CoIoT is UDP 5683 (a separate
# listener) and ESPHome is HA connecting OUT to the device on 6053. The one
# known exception is battery-powered Shelly gen2, whose outbound websocket
# targets HA's IP directly — none are deployed.
# Until those UI settings exist (fresh install), HA answers 400 to everything
# coming through here: it does not yet trust 127.0.0.1 as a proxy.
#
# The ha-mcp sidecar is served under its secret path (vault), which is the
# endpoint's only credential: this file is deployed with no_log, and must
# never get a `log` directive — access logs would write the secret to disk.
{{ homeassistant_domain }} {
    tls /etc/caddy/cert/cert.pem /etc/caddy/cert/key.pem

    @ha_mcp path /{{ vault_ha_mcp_secret_path }} /{{ vault_ha_mcp_secret_path }}/*
    handle @ha_mcp {
        reverse_proxy 127.0.0.1:{{ ha_mcp_port }}
    }

    handle {
        reverse_proxy 127.0.0.1:{{ homeassistant_port }}
    }
}
