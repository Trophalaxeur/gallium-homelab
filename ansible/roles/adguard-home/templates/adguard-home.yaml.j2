http:
  address: 0.0.0.0:3000
  session_ttl: 30d

users:
  - name: "{{ adguard_admin_user }}"
    password: "{{ adguard_admin_password_hash }}"

auth_attempts: 5
block_auth_min: 15
language: fr
theme: auto

dns:
  bind_hosts:
    - 0.0.0.0
  port: 53
  upstream_dns:
    - https://dns10.quad9.net/dns-query
    - https://dns.cloudflare.com/dns-query
  bootstrap_dns:
    - 9.9.9.9
    - 1.1.1.1
  # Disabled: the limit applies per /24 (ratelimit_subnet_len_ipv4: 24), so the
  # whole LAN shares one 20 q/s bucket and the excess is silently dropped
  # (suspected cause of Teams slowdowns). Ports 53/853 are not forwarded on the
  # Livebox, so only LAN clients can query.
  ratelimit: 0
  refuse_any: true
  cache_enabled: true
  cache_size: 4194304
  cache_optimistic: true
  enable_dnssec: false
  hostsfile_enabled: true
  serve_plain_dns: true

tls:
  enabled: true
  server_name: "{{ adguard_domain }}"
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  certificate_path: "/opt/AdGuardHome/cert/cert.pem"
  private_key_path: "/opt/AdGuardHome/cert/key.pem"

querylog:
  interval: 90d
  enabled: true
  file_enabled: true

statistics:
  interval: 1d
  enabled: true

filters:
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: true
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2

dhcp:
  enabled: false
  local_domain_name: lan

filtering:
  blocking_mode: default
  filtering_enabled: true
  rewrites_enabled: true
  protection_enabled: true
  rewrites:
    - domain: proxmox.lan
      answer: "{{ proxmox_ip }}"
      enabled: true
    - domain: proxmox.flefevre.fr
      answer: "{{ proxmox_ip }}"
      enabled: true
    - domain: adguard.lan
      answer: "{{ adguard_ip }}"
      enabled: true
    - domain: adguard.flefevre.fr
      answer: "{{ adguard_ip }}"
      enabled: true
    - domain: thallium.lan
      answer: "{{ thallium_ip }}"
      enabled: true
    - domain: neon.lan
      answer: "{{ neon_ip }}"
      enabled: true
    - domain: neon.flefevre.fr
      answer: "{{ neon_ip }}"
      enabled: true
    - domain: pbs.lan
      answer: "{{ pbs_ip }}"
      enabled: true
    - domain: pbs.flefevre.fr
      answer: "{{ pbs_ip }}"
      enabled: true
    - domain: immich.lan
      answer: "{{ immich_ip }}"
      enabled: true
    # Public-facing name is {{ immich_domain }} (photos.flefevre.fr), not
    # immich.flefevre.fr — immich.lan above stays the internal/technical name.
    - domain: "{{ immich_domain }}"
      answer: "{{ immich_ip }}"
      enabled: true
    - domain: backup.lan
      answer: "{{ backup_ip }}"
      enabled: true
    - domain: backup.flefevre.fr
      answer: "{{ backup_ip }}"
      enabled: true
    - domain: uptime.lan
      answer: "{{ uptime_ip }}"
      enabled: true
    - domain: uptime.flefevre.fr
      answer: "{{ uptime_ip }}"
      enabled: true
    - domain: hassium.lan
      answer: "{{ hassium_ip }}"
      enabled: true
    # Via the variable rather than a literal: Caddy and the cert role read the
    # same homeassistant_domain, so the three can never disagree.
    - domain: "{{ homeassistant_domain }}"
      answer: "{{ hassium_ip }}"
      enabled: true
    - domain: palladium.lan
      answer: "{{ palladium_ip }}"
      enabled: true
    - domain: palladium.flefevre.fr
      answer: "{{ palladium_ip }}"
      enabled: true
    # Share links go through palladium even from the LAN: immich-public-proxy
    # only runs there. hassium/photos keep resolving to their own LXC at home.
    - domain: "{{ immich_share_domain }}"
      answer: "{{ palladium_ip }}"
      enabled: true
    - domain: printer.lan
      answer: "{{ printer_ip }}"
      enabled: true
    - domain: printer.flefevre.fr
      answer: "{{ printer_ip }}"
      enabled: true
  blocked_services:
    schedule:
      time_zone: Europe/Paris
    ids: []

log:
  verbose: false

schema_version: 34
